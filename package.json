{
  "name": "starter-pack",
  "version": "0.0.1",
  "private": true,
  "imports": {
    "#project/*": "./*"
  },
  "scripts": {
    "start": "react-native start",
    "android": "node scripts/run-flavor.mjs android run",
    "ios": "node scripts/run-flavor.mjs ios run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx index.js src scripts tests",
    "format": "prettier --write src scripts tests config docs README.md AGENTS.md .github .maestro .prettierrc.json '*.{json,js,mjs,tsx,yaml}'",
    "format:check": "prettier --check src scripts tests config docs README.md AGENTS.md .github .maestro .prettierrc.json '*.{json,js,mjs,tsx,yaml}'",
    "test": "jest --runInBand",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:scripts",
    "create-app": "node scripts/create-app.mjs",
    "list:modules": "node scripts/create-app.mjs --list-modules",
    "list:states": "node scripts/create-app.mjs --list-states",
    "list:apis": "node scripts/create-app.mjs --list-apis",
    "doctor": "node scripts/doctor.mjs",
    "modules": "node scripts/configure-modules.mjs",
    "dependencies:audit": "node scripts/audit-dependencies.mjs",
    "android:release": "node scripts/run-flavor.mjs android release",
    "android:apk": "node scripts/run-flavor.mjs android apk",
    "android:apk:arm64": "node scripts/run-flavor.mjs android arm64",
    "android:bundle": "node scripts/run-flavor.mjs android bundle",
    "size:check": "node scripts/check-size.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "ios:pods": "cd ios && bundle exec pod install",
    "e2e": "node scripts/e2e.mjs",
    "ios:services": "bundle exec ruby scripts/setup-ios-services.rb",
    "setup:maestro": "node --use-env-proxy scripts/setup-maestro.mjs",
    "native:alignment": "node scripts/check-native-alignment.mjs",
    "brand": "node scripts/brand.mjs"
  },
  "dependencies": {
    "@apollo/client": "4.3.8",
    "@gorhom/bottom-sheet": "5.2.14",
    "@hookform/resolvers": "7.0.7",
    "@nozbe/watermelondb": "0.28.0",
    "@react-native-community/blur": "4.4.1",
    "@react-native-community/netinfo": "12.0.1",
