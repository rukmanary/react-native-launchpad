    "@rozenite/redux-devtools-plugin": "2.7.0",
    "@rozenite/storage-plugin": "2.7.0",
    "@rozenite/tanstack-query-plugin": "2.7.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "test-renderer": "1.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.3.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.15.0"
}
